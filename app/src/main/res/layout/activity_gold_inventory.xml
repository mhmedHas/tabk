<LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="#202A34"><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إجمالي القطع" android:textColor="#D8DEE5" android:textSize="12sp"/><TextView android:id="@+id/tv_stat_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#35F05A" android:textSize="21sp" android:textStyle="bold"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="القطع الموجودة" android:textColor="#D8DEE5" android:textSize="12sp"/><TextView android:id="@+id/tv_stat_present" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#35F05A" android:textSize="21sp" android:textStyle="bold"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="آخر تحديث" android:textColor="#D8DEE5" android:textSize="12sp"/><TextView android:id="@+id/tv_last_update" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--:--" android:textColor="#FFFFFF" android:textSize="16sp"/></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal"><Button android:id="@+id/btn_refresh_catalog" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="تحديث البيانات"/><TextView android:id="@+id/tv_empty" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical|end" android:paddingEnd="12dp" android:text="ضع قطع الذهب على الصحن وانتظر قراءة الشرائح..." android:textColor="#AEB8C2" android:textSize="13sp"/></LinearLayout>
